{
  "name": "loja-veloz-pagamentos",
  "version": "1.0.0",
  "description": "Microsserviço pagamentos da plataforma Pedidos Veloz",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
