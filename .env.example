# Tag das imagens (em produção: versão semântica ou sha do commit)
TAG=dev

# Porta publicada do API Gateway
GATEWAY_PORT=8080

# PostgreSQL
POSTGRES_DB=lojaveloz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha-local
PEDIDOS_DB_PASSWORD=troque-pedidos-local
ESTOQUE_DB_PASSWORD=troque-estoque-local

# Simulação do gateway de pagamento externo
PAGAMENTO_LIMITE=10000
PAGAMENTO_LATENCIA_MS=150

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# Grafana (dashboards)
GRAFANA_ADMIN_PASSWORD=admin-local
